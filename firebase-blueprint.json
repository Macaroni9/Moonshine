{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered staff profile with role and contact information",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication user UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Staff Google email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Staff member name"
        },
        "photoURL": {
          "type": "string",
          "description": "Profile picture URL"
        },
        "role": {
          "type": "string",
          "enum": ["server", "kitchen", "manager"],
          "description": "Staff role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp"
        },
        "lastSeen": {
          "type": "string",
          "format": "date-time",
          "description": "Last active timestamp"
        }
      },
      "required": ["uid", "email", "role"]
    },
    "OrderTicket": {
      "title": "OrderTicket",
      "description": "Kitchen and floor order ticket",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "number",
          "description": "Sequential order number for the shift"
        },
        "tableNumber": {
          "type": "string",
          "maxLength": 50,
          "description": "Target table identifier e.g. Table 1, Table 1/1"
        },
        "serverName": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of server who took order"
        },
        "serverUid": {
          "type": "string",
          "description": "UID of server staff"
        },
        "orderNotes": {
          "type": "string",
          "maxLength": 500,
          "description": "General table prep instructions or allergies"
        },
        "items": {
          "type": "array",
          "description": "List of dishes in order"
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "PREPARING", "READY", "SERVED", "CANCELLED"],
          "description": "Current lifecycle status of ticket"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Order creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last status update timestamp"
        },
        "readyAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when marked ready by kitchen"
        },
        "servedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when delivered to table"
        }
      },
      "required": ["orderNumber", "tableNumber", "status", "createdAt"]
    },
    "DevicePresence": {
      "title": "DevicePresence",
      "description": "Real-time presence beacon for connected staff devices",
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "description": "Client device identifier"
        },
        "uid": {
          "type": "string",
          "description": "Auth UID of the logged-in staff"
        },
        "role": {
          "type": "string",
          "enum": ["server", "kitchen"],
          "description": "Active screen role"
        },
        "displayName": {
          "type": "string",
          "description": "Staff name"
        },
        "email": {
          "type": "string",
          "description": "Staff email"
        },
        "lastSeen": {
          "type": "number",
          "description": "Epoch timestamp in milliseconds of last heartbeat"
        }
      },
      "required": ["deviceId", "uid", "role", "lastSeen"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Staff profile documents"
    },
    "/orders/{orderId}": {
      "schema": "OrderTicket",
      "description": "Live restaurant orders collection synced across all devices"
    },
    "/presence/{deviceId}": {
      "schema": "DevicePresence",
      "description": "Active staff device presence beacons"
    }
  }
}
